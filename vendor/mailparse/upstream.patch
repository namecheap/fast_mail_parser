# vendor/mailparse = mailparse 0.16.1 (as published) + this patch.
#
# The machine-readable form of PATCH.md's "The changes" section, and the thing
# .github/scripts/check_vendored_mailparse.sh re-applies on every CI run so that
# claim cannot quietly stop being true. Upstream declined the change (#217), so
# this copy is a permanent carry and every mailparse release is a hand-merge --
# which is exactly the moment a change gets lost or half-applied. A silent loss
# would pass the vendored test suite (upstream parses the same things) and show
# up only as an unexplained 4-10x regression in the benchmark gate.
#
# Regenerate after any edit under vendor/mailparse/, and update PATCH.md with it:
#
#   T=$(mktemp -d)
#   tar xzf ~/.cargo/registry/cache/*/mailparse-0.16.1.crate -C "$T"
#   cp -R vendor/mailparse "$T/vendored"
#   for f in PATCH.md upstream.patch Cargo.toml.orig .cargo_vcs_info.json Cargo.lock .cargo-ok; do
#     rm -f "$T/mailparse-0.16.1/$f" "$T/vendored/$f"
#   done
#   ( cd "$T" && diff -ruN -x target mailparse-0.16.1 vendored ) > vendor/mailparse/upstream.patch
#
# (then re-add this header)
